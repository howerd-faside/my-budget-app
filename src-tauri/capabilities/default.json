{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://query1.finance.yahoo.com/**" },
        { "url": "https://api.coingecko.com/**" },
        { "url": "https://api.binance.com/**" }
      ]
    }
  ]
}
